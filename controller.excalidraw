      "text": "Proto spec file\n\n# group \"/test-service\" \n\ncontroller TestController{\n    path = \"/test1\"\n    GET(Params1) Return1\n}\n\ncontroller TestController2{\n    path = \"/test2\"\n    POST(Params1, Body2) Return2\n}\n\n# group \"/test-wervice2\"\n\ncontroller TestController3{\n    path = \"/test2\"\n    stream POST(Params1, Body2)\n}\n\n\ndeclare Params1 query {\n    param1 string // by default assigns same name for json keys\n    param2 string, json:\"pararam\"\n}\n\ndeclare Body1 body {\n    param1 string // by default assigns same name for json keys\n    param2 string, json:\"pararam\"\n}\n",
